<Window x:Class="SophiaScriptWrapper.Donate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:local="clr-namespace:SophiaScriptWrapper"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"        
        WindowStyle="ToolWindow"
        
        Title="Donate" Height="165" Width="270"
>
    <Viewbox Name="vbDonateWindow">
        <Grid Height="145" Width="270" HorizontalAlignment="Stretch">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" />

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="25"/>

                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Name="tbDonate"    
                Text="Donate" FontSize="14" FontFamily="Verdana" FontWeight="Bold"  
                TextAlignment="Center" VerticalAlignment="Top" Margin="0,2"></TextBlock>

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://ko-fi.com/farag" TextDecorations="None" RequestNavigate="Hyperlink_RequestNavigate">
                        <Image Source="/Resources/ko-fi_icon.png" Height="70" ></Image>
                    </Hyperlink>
                    </TextBlock>

                    <DockPanel Grid.Row="2">
                        <TextBlock Name="TextBlockWithHyperlink" TextAlignment="Center" FontSize="13" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,0">
                        <Hyperlink NavigateUri="https://ko-fi.com/farag" RequestNavigate="Hyperlink_RequestNavigate">
                            ko-fi.com/farag
                        </Hyperlink>
                        </TextBlock>
                    </DockPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
