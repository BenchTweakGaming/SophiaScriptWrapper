<Window x:Class="SophiaScriptWrapper.Info3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:local="clr-namespace:SophiaScriptWrapper"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        
        Title="Information" Height="270" Width="270"
>
    <Grid>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>

                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Name="tblckHeader"    
                Text="Information" FontSize="14" FontFamily="Verdana" FontWeight="Bold"  
                TextAlignment="Center" VerticalAlignment="Top" Margin="0,2"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Name="tblckSubHeaderOne"
                           Text="Current OS" FontSize="12" FontFamily="Verdana" FontWeight="Bold"  
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2" Foreground="#FF2A6B9F"></TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0" Name="tblckCurrentOS" 
                           Text="Current OS" FontSize="10" FontFamily="Verdana" TextAlignment="Center" 
                           VerticalAlignment="Top" Margin="0,2"></TextBlock>

                <TextBlock Grid.Row="3" Grid.Column="0" Name="tblckSubHeaderTwo" 
                           Text="Imported Sophia Script" FontSize="12" FontFamily="Verdana" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2" Foreground="#FF2A6B9F"></TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="0" Name="tblckImportedSophiaScript"
                           Text="Imported Sophia Script" FontSize="10" FontFamily="Verdana"   
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2"></TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="0" Name="tblckSubHeaderThree" 
                           Text="PowerShell Versions Installed" FontSize="12" FontFamily="Verdana" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2" Foreground="#FF2A6B9F"></TextBlock>
                <TextBlock Grid.Row="6" Grid.Column="0" Name="tblckPowerShellVersionsInstalled"
                           Text="Imported Sophia Script" FontSize="10" FontFamily="Verdana"   
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2"></TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="0" Name="tblckSubHeaderFour"
                           Text="Compatibility" FontSize="12" FontFamily="Verdana" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2" Foreground="#FF2A6B9F"></TextBlock>
                <TextBlock Grid.Row="8" Grid.Column="0" Name="tblckCompatibility"
                           Text="Compatibility" FontSize="10" FontFamily="Verdana"
                           TextAlignment="Center" VerticalAlignment="Top" Margin="0,2"></TextBlock>


            </Grid>
        </StackPanel>

    </Grid>
</Window>
