<Window x:Class="SophiaScriptWrapper.TestOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:local="clr-namespace:SophiaScriptWrapper"
        mc:Ignorable="d"
        Title="Test Output Window" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <TextBox Name="tbOutput" Grid.Row="0" Grid.Column="0" AcceptsReturn="True"></TextBox>
        </ScrollViewer>
        <Button Click="Close_Click" HorizontalAlignment="Center" Content="Close" Grid.Row="1" Grid.Column="0"></Button>
    </Grid>
</Window>
